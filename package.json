{
  "name": "srp-remake",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:track",
    "validate:track": "vitest run src/validation",
    "build": "tsc && vite build",
    "postbuild": "node tools/make404.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest",
    "test:e2e": "playwright test",
    "probe:cpu": "node tools/cpuProbe.mjs",
    "test:coverage": "vitest run --coverage",
    "gen:tracks": "tsx tools/gen_tracks.ts",
    "gen:icons": "node tools/makeIcons.mjs",
    "gen:diagrams": "tsx tools/diagrams/gen.ts",
    "backend:up": "podman-compose up --build api",
    "backend:down": "podman-compose down",
    "backend:logs": "podman-compose logs -f api",
    "backend:restart": "npm run backend:down && npm run backend:up",
    "backend:test": "npm --prefix backend test",
    "backend:build": "npm --prefix backend run build"
  },
  "devDependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
